FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i \
      -e 's|http://deb.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|' \
      -e 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|' \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends bash git nodejs npm \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /runner
COPY runner.py ./
USER 10001:10001
CMD ["python", "/runner/runner.py"]
